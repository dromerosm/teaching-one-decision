# Copy to config.env (git-ignored) and fill in. Nothing here is specific to the machine we used.
GPU_HOST=<HOST_OR_IP>                 # SSH host of the GPU server (a DGX Spark in our runs)
GPU_USER=<USER>                       # existing account on that host
SSH_PORT=22
# Optional: reach the host through a local SOCKS5 proxy (for example a WireGuard client such as wireproxy).
# Leave empty for a direct connection.
SOCKS_PROXY=<127.0.0.1:PORT or empty>
# Known-hosts file holding the host key you verified with the machine's owner.
KNOWN_HOSTS=<PATH_TO_KNOWN_HOSTS>
# Where the work lives on the server (user space, no sudo needed).
REMOTE_ROOT=/home/<USER>/teaching-one-decision
